#!/bin/sh
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH
LIB=/usr/local/libexec/fw0/fw0-lib
[ -r "$LIB" ] || LIB="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/fw0-lib"
. "$LIB"
PROFILES=${FW0_PROFILES_DIR:-/usr/local/etc/fw0/vpn/profiles}
OUT=${FW0_ENDPOINT_TABLE:-/etc/pf/tables/vpn_endpoints.txt}
[ "$(id -u)" -eq 0 ] || fw0_die "rebuild-vpn-endpoints requiere root"

tmp=$(mktemp "${OUT}.XXXXXX")
body=$(mktemp "${OUT}.body.XXXXXX")
trap 'rm -f "$tmp" "$body"' EXIT HUP INT TERM
: > "$body"

for conf in "$PROFILES"/*.conf; do
    [ -f "$conf" ] || continue
    profile=$(basename "$conf" .conf)
    fw0_valid_profile "$profile" || continue
    [ -f "$PROFILES/$profile.meta" ] || continue
    if fw0_profile_validate "$profile"; then
        printf '%s\n' "$WG_ENDPOINT_IP" >> "$body"
    else
        fw0_die "perfil inválido; no se puede reconstruir tabla: $profile"
    fi
done

printf '%s\n' '# Generated by rebuild-vpn-endpoints. Do not edit.' > "$tmp"
sort -u "$body" >> "$tmp"
install -m 0644 "$tmp" "$OUT"
echo "vpn endpoint table rebuilt: $OUT"
