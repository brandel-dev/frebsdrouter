#!/bin/sh
# Shared fw0 helpers. Must be owned by root and not writable by unprivileged users.

fw0_die() { echo "$*" >&2; exit 1; }
fw0_is_uint() { case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
fw0_valid_if() { printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9_.:-]{1,32}$'; }
fw0_valid_profile() { printf '%s\n' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,31}$'; }
fw0_valid_ipv4() {
    printf '%s\n' "$1" | awk -F. '
        NF != 4 { bad=1; next }
        { for (i=1; i<=4; i++) if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) bad=1 }
        END { exit bad ? 1 : 0 }
    '
}
fw0_valid_ipv4_32() { case "$1" in */32) fw0_valid_ipv4 "${1%/32}";; *) return 1;; esac; }
fw0_valid_port() { fw0_is_uint "$1" && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
fw0_valid_cidr4() {
    ip=${1%/*}; pfx=${1#*/}
    [ "$ip" != "$1" ] || return 1
    fw0_valid_ipv4 "$ip" || return 1
    fw0_is_uint "$pfx" || return 1
    [ "$pfx" -ge 0 ] && [ "$pfx" -le 32 ]
}
fw0_hash_file() {
    f=$1
    if command -v sha256 >/dev/null 2>&1; then sha256 -q "$f"
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$f" | awk '{print $1}'
    else return 1
    fi
}
fw0_stat_mode_owner() {
    f=$1
    if stat -f '%Su:%Sg:%Lp' "$f" >/dev/null 2>&1; then stat -f '%Su:%Sg:%Lp' "$f"
    else stat -c '%U:%G:%a' "$f"
    fi
}
fw0_pf_enabled() { pfctl -s info 2>/dev/null | grep -q 'Status: Enabled'; }
fw0_iface_exists() { ifconfig "$1" >/dev/null 2>&1; }
fw0_kv_get() {
    key=$1 file=$2
    awk -F= -v k="$key" '$1==k {sub(/^[^=]*=/,""); print; exit}' "$file"
}
fw0_unquote() {
    v=$1
    case "$v" in
        \"*\") v=${v#\"}; v=${v%\"} ;;
        *\"*|*\'*) return 1 ;;
    esac
    printf '%s\n' "$v"
}

# Strict data parser for profile metadata. It NEVER sources/evals the file.
# Exports WG_ADDRESS, WG_ENDPOINT_IP and WG_ENDPOINT_PORT in the current shell.
fw0_profile_meta_load() {
    meta=$1
    [ -r "$meta" ] || return 1
    WG_ADDRESS=''; WG_ENDPOINT_IP=''; WG_ENDPOINT_PORT=''
    seen_addr=0; seen_ip=0; seen_port=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*) continue ;;
            WG_ADDRESS=*)
                [ "$seen_addr" -eq 0 ] || return 1
                WG_ADDRESS=$(fw0_unquote "${line#WG_ADDRESS=}") || return 1
                seen_addr=1 ;;
            WG_ENDPOINT_IP=*)
                [ "$seen_ip" -eq 0 ] || return 1
                WG_ENDPOINT_IP=$(fw0_unquote "${line#WG_ENDPOINT_IP=}") || return 1
                seen_ip=1 ;;
            WG_ENDPOINT_PORT=*)
                [ "$seen_port" -eq 0 ] || return 1
                WG_ENDPOINT_PORT=$(fw0_unquote "${line#WG_ENDPOINT_PORT=}") || return 1
                seen_port=1 ;;
            *) return 1 ;;
        esac
    done < "$meta"
    [ "$seen_addr" -eq 1 ] && [ "$seen_ip" -eq 1 ] && [ "$seen_port" -eq 1 ] || return 1
    fw0_valid_ipv4_32 "$WG_ADDRESS" || return 1
    fw0_valid_ipv4 "$WG_ENDPOINT_IP" || return 1
    fw0_valid_port "$WG_ENDPOINT_PORT" || return 1
}

fw0_profile_validate() {
    profile=$1
    fw0_valid_profile "$profile" || return 1
    profiles=${FW0_PROFILES_DIR:-/usr/local/etc/fw0/vpn/profiles}
    meta="$profiles/${profile}.meta"
    conf="$profiles/${profile}.conf"
    [ -f "$meta" ] && [ -f "$conf" ] || return 1
    fw0_profile_meta_load "$meta" || return 1

    grep -Eq '^[[:space:]]*PrivateKey[[:space:]]*=[[:space:]]*[^[:space:]]+' "$conf" || return 1
    grep -Eq '^[[:space:]]*PublicKey[[:space:]]*=[[:space:]]*[^[:space:]]+' "$conf" || return 1
    grep -Eq '^[[:space:]]*AllowedIPs[[:space:]]*=.*(^|[ ,])0\.0\.0\.0/0([ ,]|$)' "$conf" \
        || grep -Eq '^[[:space:]]*AllowedIPs[[:space:]]*=[[:space:]]*0\.0\.0\.0/0[[:space:]]*$' "$conf" \
        || return 1
    grep -Eq "^[[:space:]]*Endpoint[[:space:]]*=[[:space:]]*${WG_ENDPOINT_IP}:${WG_ENDPOINT_PORT}[[:space:]]*$" "$conf" || return 1
    ! grep -Eq '^[[:space:]]*(Address|DNS|MTU|Table)[[:space:]]*=' "$conf" || return 1
    ! grep -q 'REEMPLAZAR' "$conf" || return 1

    # On the target FreeBSD host profiles must be root-only secrets.
    if [ "$(uname -s 2>/dev/null || true)" = FreeBSD ]; then
        [ "$(fw0_stat_mode_owner "$meta")" = 'root:wheel:600' ] || return 1
        [ "$(fw0_stat_mode_owner "$conf")" = 'root:wheel:600' ] || return 1
    fi

    FW0_PROFILE_META=$meta
    FW0_PROFILE_CONF=$conf
}
